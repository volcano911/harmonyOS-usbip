+    // （鸿蒙拿不到 sysfs 拓扑，只能走这条回退分支，见 tools.h）。Windows 侧若把
+    // 上一次的 devid 存进了配置/端口，设备重新插上后它会拿着旧 busid 来 attach，
+    // 服务端找不到就回 NoDev、客户端显示「找不到 1-3 的设备」并断开。
+    //
+    // 只剩一台可导出设备时这个请求的意图是唯一确定的，直接改用它；多台时无法
+    // 判断用户要哪一台，宁可失败也不猜（否则可能把错误的设备挂给客户端）。
+    //
+    // [重要] 这里必须统计"可用 + 正在使用"的总数，不能只看 available。
+    // 之前只判 available_devices.size()==1，在"一台在用、一台空闲"的布局下会
+    // 把陌生 busid 的请求落在那台**空闲**设备上，等于把用户没点的设备挂出去。
+    if (matched == available_devices.end() &&
+        available_devices.size() + using_devices.size() == 1 &&
+        available_devices.size() == 1) {
+        matched = available_devices.begin();
+        SPDLOG_WARN("客户端请求的 busid {} 已失效，自动改用唯一可导出设备 {}", wanted_busid, (*matched)->busid);
+    }
+
+    if (matched == available_devices.end()) {
+        SPDLOG_WARN("找不到busid为{}的设备", wanted_busid);
+        return nullptr;
+    }
+
+    // 注意：此处必须用设备自身的 busid 作 using 表的键。重定向时它与
+    // wanted_busid 不同，若沿用心跳参数，后续 release_device 会因为找不到键
+    // 而失败，设备就永久卡在 using 列表里。
+    const std::string actual_busid = (*matched)->busid;
+    SPDLOG_INFO("将{}放入正在使用的设备中", actual_busid);
+    //将想要的设备放入正在使用的设备
+    auto ret = (using_devices[actual_busid] = std::move(*matched));
+    //删掉可用设备中的这个设备
+    available_devices.erase(matched);
+    return ret;
+}
+
+namespace {
+/** [OHOS 移植补丁] 只取 "ip:port" 里的 IP 部分（端口每次连接都变，不能直接比） */
+std::string PeerIpOnly(const std::string &peer) {
+    if (peer.empty()) {
+        return peer;
+    }
+    // IPv6 是 "[::1]:1234" 形式，要跳过地址内部的冒号
+    if (peer.front() == '[') {
+        auto close = peer.find("]:");
+        return close == std::string::npos ? peer : peer.substr(1, close - 1);
+    }
+    auto pos = peer.rfind(':');
+    return pos == std::string::npos ? peer : peer.substr(0, pos);
+}
+} // namespace
+
+bool usbipdcpp::Server::find_using_session(const std::string &busid, int &idle_seconds, std::string &peer) {
+    // 先把会话快照取出来，再在锁外查询：Session 内部还有自己的状态锁，
+    // 持着 session_list_mutex 去拿会话锁没有必要，也容易和收尾路径交叉
+    std::vector<std::shared_ptr<Session>> snapshot;
+    {
+        std::lock_guard lock(session_list_mutex);
+        for (auto &entry: sessions) {
+            if (auto session = entry.second.lock()) {
+                snapshot.push_back(std::move(session));
+            }
+        }
+    }
+    for (auto &session: snapshot) {
+        auto owned = session->imported_busid();
+        if (owned && *owned == busid) {
+            idle_seconds = session->idle_seconds();
+            peer = session->peer_address;
+            return true;
         }
     }
-    SPDLOG_WARN("找不到busid为{}的设备", wanted_busid);
-    return nullptr;
+    return false;
+}
+
+int usbipdcpp::Server::using_device_idle_seconds(const std::string &busid) {
+    int idle = -1;
+    std::string peer;
+    if (!find_using_session(busid, idle, peer)) {
+        return -1;
+    }
+    return idle;
+}
+
+bool usbipdcpp::Server::takeover_stale_session(const std::string &busid, int idle_threshold,
+                                               const std::string &requester_peer) {
+    std::shared_ptr<AbstDeviceHandler> handler;
+    {
+        std::lock_guard lock(devices_mutex);
+        auto it = using_devices.find(busid);
+        if (it == using_devices.end()) {
+            return false;
+        }
+        handler = it->second->handler;
+    }
+
+    int idle = -1;
+    std::string owner_peer;
+    if (!find_using_session(busid, idle, owner_peer)) {
+        // [OHOS 移植补丁] using 列表里有记录，却找不到任何持有它的会话 —— 这是
+        // 服务端侧的孤儿记录（会话对象已销毁但设备没被放回可用列表）。以前这里
+        // 直接 return false，于是客户端永远撞"设备忙"，只能停服务重开。孤儿记录
+        // 不可能有正在进行的传输，直接回收。
+        SPDLOG_WARN("设备 {} 仍在 using 列表但没有对应会话，回收孤儿记录", busid);
+        release_device(busid);
+        return true;
+    }
+
+    // [OHOS 移植补丁] 同一个客户端重新 attach 时不用等满超时。
+    //
+    // 它刚刚为这台设备建立过连接，现在又来一个——说明上一条它自己已经放弃了
+    // （Windows 侧 attach 失败/超时后，socket 常常还挂在进程里，服务端既读不到
+    // EOF 也收不到新数据）。这时如果还按"静默 45 秒才算僵尸"来判，客户端会
+    // 一直撞"设备忙"，用户只能停服务重开。
+    //
+    // 反过来，来自**不同** IP 的连接绝不能被抢：两台电脑同时在线时那样会互相
+    // 踢，谁都连不上。所以只认"同一个 IP"这一个信号，而且仍然要求它安静了
+    // 几秒（避免刚握手就被自己的另一条连接打断）。
+    //
+    // [OHOS 移植补丁] 同 IP 阈值从 10 秒收到 2 秒。
+    //
+    // 局域网里 IP 唯一，"同一 IP 又来一次 IMPORT"没有第二种解释：它就是要
+    // 重连。Windows 侧驱动超时重连时，旧 socket 常常还挂在进程里（既没有 FIN
+    // 也没有新数据），服务端此时如果还要求静默 10 秒，新连接会连续撞
+    // "设备忙"，驱动按指数退避重试，用户看到的就是"断一次之后再也连不上"。
+    // 2 秒只用来排除"同一条连接上两个线程同时提交"这类瞬时重叠。
+    int threshold = idle_threshold;
+    const std::string requester_ip = PeerIpOnly(requester_peer);
+    const std::string owner_ip = PeerIpOnly(owner_peer);
+    const bool same_client = !requester_ip.empty() && requester_ip == owner_ip;
+    if (same_client) {
+        constexpr int kSameClientIdleSeconds = 2;
+        if (threshold > kSameClientIdleSeconds) {
+            threshold = kSameClientIdleSeconds;
+        }
+    }
+
+    // 正在传输的会话绝不抢：两台客户端同时在线时会互相踢，谁都连不上。
+    if (idle < threshold) {
+        return false;
+    }
+
+    if (same_client) {
+        SPDLOG_WARN("同一个客户端({})重新 attach 设备 {}，旧会话已静默 {} 秒，直接接管",
+                    requester_ip, busid, idle);
+    }
+    else {
+        SPDLOG_WARN("设备 {} 的占用会话已静默 {} 秒（来自 {}），判定为僵尸会话，接管给 {}",
+                    busid, idle, owner_ip.empty() ? "未知" : owner_ip,
+                    requester_ip.empty() ? "新连接" : requester_ip);
+    }
+    if (handler) {
+        // 只停止会话，不标记设备已移除：收尾时 release_device 会把设备放回
+        // 可用列表，接下来的导入流程才能真正拿到它
+        handler->trigger_session_stop();
+    }
+
+    // 会话收尾在它自己的线程上异步进行，等设备真的回到可用列表
+    for (int i = 0; i < 80; ++i) {
+        {
+            std::shared_lock lock(devices_mutex);
+            if (!using_devices.contains(busid)) {
+                SPDLOG_INFO("僵尸会话已释放 {}，设备回到可用列表", busid);
+                return true;
+            }
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(25));
+    }
+    SPDLOG_WARN("接管 {} 超时：设备仍在 using 列表", busid);
+    return false;
+}
+
+std::optional<std::string> usbipdcpp::Server::single_exported_busid() {
+    std::shared_lock lock(devices_mutex);
+    if (available_devices.size() + using_devices.size() != 1) {
+        return std::nullopt;
+    }
+    if (!available_devices.empty()) {
+        return available_devices.front()->busid;
+    }
+    return using_devices.begin()->first;
 }
 
